# Regression testing script for vAmiga
# Dirk W. Hoffmann, 2026

# Setup the test environment
# AGA Agnus, AGA Denise, 68EC020
regression setup A1200_2MB /tmp/kick13.rom

# Work around the A1200_2MB scheme's CPU_OVERCLOCKING default (see
# Agnus/Registers/FMODE's README)
cpu set OVERCLOCKING 0

# Run the test
regression run /tmp/CPU_Prefetch_MULS_68020.adf
wait 9 seconds

# Exit with a screenshot
screenshot save CPU_Prefetch_MULS_68020
